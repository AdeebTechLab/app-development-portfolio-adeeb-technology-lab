    "process": [
      {
        "title": "Discuss your app idea",
        "text": "Tell us about your idea on WhatsApp or a call. We learn who will use the app, what they need to do in it and which platforms you need."
      },
      {
        "title": "Plan and design the screens",
        "text": "We list the features, map how users move through the app and design every screen. You approve the look before we write any code."
      },
      {
        "title": "Develop",
        "text": "We build the app, its backend and the admin panel, and share test builds so you can try progress on your own phone."
      },
      {
        "title": "Test on real devices",
        "text": "We test on different phones, screen sizes and Android or iOS versions, check speed and offline behaviour, and fix every issue before launch."
      },
      {
        "title": "Publish to the stores",
        "text": "We prepare the store listing, icon, screenshots and privacy policy and publish the app on Google Play and the App Store under your account."
      },
      {
        "title": "Support and updates",
        "text": "We stay available for updates, new features, store policy changes and support after launch."
      }
    ]
  },
